        <mxCell id="dict" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F3;strokeColor=#3F7480;fontColor=#17333A;fontSize=12;align=left;spacing=8;" value="report_id — CJ- plus three digits&lt;br&gt;asset_id — two-letter prefix plus three digits&lt;br&gt;asset_type — STREETLIGHT, DRAIN, BRIDGE&lt;br&gt;finding_code — LAMP_OUT, BLOCKED, SURFACE_DAMAGE&lt;br&gt;priority — ROUTINE or URGENT; does not change department&lt;br&gt;captured_at — UTC YYYY-MM-DDTHH:MM:SSZ&lt;br&gt;photo_ref — IMG- plus three digits; no image supplied&lt;br&gt;survey_area — NORTH, CENTRAL, SOUTH; not coordinates" vertex="1">
